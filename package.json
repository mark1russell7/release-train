{
  "$schema": "https://json.schemastore.org/package",
  "name": "release-train-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "package": "template package",
    "template": "template repo",
    "test": "pnpm -r run test && pnpm run test:release",
    "test:release": "node --test \"scripts/release/*.test.mjs\"",
    "typecheck": "pnpm -r run typecheck",
    "lint:ste": "ste-lint",
    "check:conventions": "conventions check",
    "check:api": "api-report check"
  },
  "devDependencies": {
    "@mark1russell7/api-report": "^0.2.0",
    "@mark1russell7/conventions": "^0.2.0",
    "@mark1russell7/cue": "github:mark1russell7/cue#9005ddbd0aac6d10992f638506b14e16b1eb2de8",
    "@mark1russell7/ste-lint": "github:mark1russell7/ste-lint#aa06c2c28b1c6b2b2e913443bfdf9fa170524905",
    "@mark1russell7/template-cli": "^0.1.0",
    "publint": "^0.3.25",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
