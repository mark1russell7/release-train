{
  "$schema": "https://json.schemastore.org/package",
  "name": "release-train-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "package": "template package",
    "template": "template repo",
    "test": "pnpm -r run test && pnpm run test:release",
    "test:release": "node --test \"scripts/release/*.test.mjs\"",
    "typecheck": "pnpm -r run typecheck",
    "lint:ste": "ste-lint"
  },
  "devDependencies": {
    "@mark1russell7/template-cli": "^0.1.0",
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@mark1russell7/ste-lint": "github:mark1russell7/ste-lint",
    "publint": "^0.3.25",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
