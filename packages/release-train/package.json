{
  "$schema": "https://json.schemastore.org/package",
  "name": "@release-train/release-train",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "plan": "node src/bin.ts plan"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue#9005ddbd0aac6d10992f638506b14e16b1eb2de8",
    "@types/node": "^26.6.4",
    "@types/semver": "^7.8.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "semver": "^7.8.5",
    "yaml": "^2.9.1"
  },
  "description": "The release train: it reads the npm packages of an owner and plans the next releases and updates."
}
