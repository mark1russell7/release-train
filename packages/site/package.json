{
  "$schema": "https://json.schemastore.org/package",
  "name": "@release-train/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The GitHub Pages site of release-train: a plan explorer that runs the planner of the library in the browser.",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue#9005ddbd0aac6d10992f638506b14e16b1eb2de8",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@release-train/release-train": "workspace:*"
  }
}
